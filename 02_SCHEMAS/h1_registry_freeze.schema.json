{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h1_registry_freeze.schema.json",
  "title": "Immutable H1 Candidate Registry Freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "freeze_id",
    "registry_version",
    "contract_version",
    "registry_frozen_at",
    "candidate_track_ids",
    "status_counts",
    "registry_content_hash",
    "content_hash"
  ],
  "properties": {
    "freeze_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "registry_frozen_at": {"type": "string", "format": "date-time"},
    "candidate_track_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "status_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "registry_content_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
