{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h1_pilot_source.schema.json",
  "title": "H1 Real-data Pilot Primary Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "created_at", "sources", "content_hash"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "source_revision_id", "origin_group", "title", "publisher",
          "source_type", "source_tier", "primary_source", "publication_date",
          "published_at", "available_at", "availability_basis", "publisher_timezone",
          "accessed_at", "url", "local_archive_path", "content_hash", "excerpt", "locator"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_revision_id": {"type": "string", "minLength": 1},
          "origin_group": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "source_tier": {"enum": ["P1_EVENT", "P1_COUNTERPARTY"]},
          "primary_source": {"const": true},
          "publication_date": {"type": "string", "format": "date"},
          "published_at": {"type": "string", "format": "date-time"},
          "available_at": {"type": "string", "format": "date-time"},
          "availability_basis": {"enum": ["EXACT_TIMESTAMP", "PUBLISHER_DATE_FALLBACK", "OTHER_APPROVED_PROXY"]},
          "publisher_timezone": {"type": "string", "minLength": 1},
          "accessed_at": {"type": "string", "format": "date-time"},
          "url": {"type": "string", "format": "uri"},
          "local_archive_path": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "excerpt": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  }
}
