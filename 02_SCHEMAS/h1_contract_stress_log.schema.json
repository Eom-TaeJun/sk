{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h1_contract_stress_log.schema.json",
  "title": "H1 Real-disclosure Contract Stress Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["log_version", "created_at", "issues"],
  "properties": {
    "log_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id", "source_ids", "event_ids", "original_wording",
          "model_candidate_classification", "current_deterministic_result",
          "human_interpretation", "rule_assessment", "action",
          "affected_decision_question"
        ],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "original_wording": {"type": "string", "minLength": 1},
          "model_candidate_classification": {"type": "string", "minLength": 1},
          "current_deterministic_result": {"type": "string", "minLength": 1},
          "human_interpretation": {"type": "string", "minLength": 1},
          "rule_assessment": {"type": "string", "minLength": 1},
          "action": {"enum": ["NO_CHANGE", "FIXTURE_ONLY", "VALIDATION_RULE_CHANGE", "SCHEMA_CHANGE", "DOCUMENTATION_CHANGE"]},
          "affected_decision_question": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
