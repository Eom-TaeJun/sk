{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H1 Historical Atomic Event",
  "type": "object",
  "required": [
    "case_id",
    "track_id",
    "event_id",
    "event_role",
    "signal_type",
    "signal_subtype",
    "direction",
    "event_at",
    "available_at",
    "date_precision",
    "source_id",
    "entity",
    "product",
    "platform",
    "geography",
    "stated_scope",
    "order_distance",
    "cutoff_id",
    "cutoff_at",
    "outcome_window",
    "realization_status",
    "false_positive_status",
    "right_censored",
    "counterevidence_ids",
    "claim",
    "excerpt",
    "locator",
    "evidence_level",
    "supporting_source_ids",
    "is_predictor"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_role": {"enum": ["SIGNAL", "CONTEXT", "COUNTEREVIDENCE", "OUTCOME"]},
    "signal_type": {
      "enum": ["CAPEX", "SAMPLE", "QUALIFICATION", "LTA", "SUPPLY_COMMITMENT", "POWER_READY", "SHIPMENT", "COMMERCIAL_OUTCOME"]
    },
    "direction": {"enum": ["POSITIVE", "NEGATIVE", "NEUTRAL"]},
    "date_precision": {"enum": ["DAY", "MONTH_END", "QUARTER_END", "YEAR_END"]},
    "right_censored": {"type": "boolean"},
    "is_predictor": {"type": "boolean"},
    "lead_days": {"type": ["integer", "null"]}
  },
  "additionalProperties": true
}
