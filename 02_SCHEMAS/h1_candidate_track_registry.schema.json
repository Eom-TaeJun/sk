{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h1_candidate_track_registry.schema.json",
  "title": "Outcome-neutral H1 Candidate Track Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "contract_version",
    "historical_start",
    "created_at",
    "outcome_neutral",
    "tracks",
    "content_hash"
  ],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "historical_start": {"type": "string", "format": "date"},
    "created_at": {"type": "string", "format": "date-time"},
    "outcome_neutral": {"const": true},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track_id",
          "track_type",
          "entity",
          "product",
          "platform",
          "generation",
          "geography",
          "start_boundary",
          "inclusion_reason",
          "first_known_candidate_source_family",
          "left_truncated",
          "right_censoring_risk",
          "expected_source_families",
          "known_scope_limitation",
          "registry_status",
          "status_reason"
        ],
        "properties": {
          "track_id": {"type": "string", "minLength": 1},
          "track_type": {
            "enum": [
              "PRODUCT_COMMERCIALIZATION_TRACK",
              "CUSTOMER_PLATFORM_REALIZATION_TRACK"
            ]
          },
          "entity": {"type": "string", "minLength": 1},
          "product": {"type": ["string", "null"]},
          "platform": {"type": ["string", "null"]},
          "generation": {"type": "string", "minLength": 1},
          "geography": {"type": ["string", "null"]},
          "start_boundary": {"type": "string", "format": "date"},
          "inclusion_reason": {"type": "string", "minLength": 1},
          "first_known_candidate_source_family": {"type": "string", "minLength": 1},
          "left_truncated": {"type": "boolean"},
          "right_censoring_risk": {"type": "boolean"},
          "expected_source_families": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "known_scope_limitation": {"type": "string", "minLength": 1},
          "registry_status": {"enum": ["PRE_REGISTERED", "HOLD", "EXCLUDED"]},
          "status_reason": {"type": ["string", "null"]}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
