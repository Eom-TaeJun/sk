  "power_method_changes": [
    {
      "id": "separate_load_supply",
      "rule": "발전 접속 큐는 공급 후보, 대형 부하 접속 신청은 구매 후보다. 서로 다른 모집단·ID·상태 체계를 사용한다.",
      "basis": [
        "lbnl_queued_2026",
        "lbnl_large_load_review"
      ]
    },
    {
      "id": "stage_before_mw",
      "rule": "관심/신청→연구비 납부→LOA/ESA 약정→인허가·송전 공사→통전 승인→관측 가동→실제 MW/MWh를 별도 사건으로 저장한다. 모든 프로젝트가 같은 순서를 거친다고 가정하지 않는다.",
      "basis": [
        "aep_load_study_letter",
        "aep_2026_update",
        "ercot_large_load"
      ]
    },
    {
      "id": "money_instrument",
      "rule": "발표 투자액, 발주액, 담보/신용장/보증, CIAC, 회계 capex, 고객 현금 수납은 다른 금전 사건이다. 계약 MW만으로 현금 유입을 계산하지 않는다.",
      "basis": [
        "aep_load_study_letter",
        "aep_2026_update"
      ]
    },
    {
      "id": "vintage_and_cohort",
      "rule": "발표일/관측 기준일/효력일/대상 연도/수정일을 분리한다. 단계 전환율은 같은 프로젝트 cohort와 기간·용량 정의가 확인될 때만 계산한다. 다른 스냅샷 합계를 나누지 않는다.",
      "basis": [
        "aep_2026_update",
        "lbnl_queued_2026"
      ]
    },
    {
      "id": "model_is_not_meter",
      "rule": "명목 IT 용량, 계약 접속 MW, 실제 동시 피크 MW, 비동시 사업장 최대값의 합, 연간 TWh를 구분한다. 모델·설문은 측정값과 별도 레이어에 둔다.",
      "basis": [
        "iea_2026",
        "lbnl_dc_2025_update",
        "epri_2026",
        "uptime_2026",
        "pjm_accuracy_2026"
      ]
    },
    {
      "id": "ppi_ppa_and_backlog",
      "rule": "PPA/원전 정격 MW는 현재 AI 전력 소비가 아니다. 기업 전체 backlog도 AI 주문이 아니다. 명명된 고객·제품·부지·서비스 개시·인도 사건이 확인된 부분만 관계에 연결한다.",
      "basis": [
        "iea_2026",
        "company_map_existing_confirmed_relations"
      ]
    },
    {
      "id": "observability",
      "rule": "한 고객 비공개/영업비밀로 억제된 자료는 0으로 채우지 않는다. 공개 문서가 없음은 취소 또는 부하 없음의 증거가 아니다. 원 데이터의 무료 여부와 보고서 무료 여부를 분리한다.",
      "basis": [
        "pjm_accuracy_2026",
        "lbnl_dc_2025_update",
        "epri_2026",
        "uptime_2026"
      ]
    },
    {
      "id": "artifact_grain_not_report_title",
      "rule": "보고서에 월별 그림이 있어도 부속 XLS가 같은 granularity를 담는다고 가정하지 않는다. PJM 공개 XLS는 연간 July Peak만 확인됐다. 보고서·다운로드 파일·그림의 범주와 시간을 별도 검증한다.",
      "basis": [
        "pjm_accuracy_2026"
      ]
    }
  ],
